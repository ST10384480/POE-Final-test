{
  "name": "hustlehub-backend",
  "version": "3.0.0",
  "description": "HustleHub+ secure freelance marketplace backend - Part 3: DevSecOps, Monitoring and Finalisation",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/utils/seed.js",
    "test:api": "newman run postman/HustleHub.postman_collection.json -e postman/HustleHub.postman_environment.json --insecure --reporters cli,json --reporter-json-export postman/newman-report.json",
    "build": "node scripts/build-check.js",
    "test": "jest --runInBand --forceExit",
    "test:ci": "jest --runInBand --forceExit --coverage",
    "lint": "eslint .",
    "lint:report": "node scripts/lint-report.js"
  },
  "keywords": [
    "hustlehub",
    "express",
    "jwt",
    "auth",
    "mern",
    "rbac"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^15.11.0",
    "jest": "^29.7.0",
    "newman": "^6.2.3",
    "newman-reporter-htmlextra": "^1.22.5",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/utils/seed.js",
      "!src/server.js"
    ],
    "coverageReporters": [
      "text",
      "text-summary",
      "lcov"
    ]
  }
}
